* hand-written deck, not exported from any drawing
.title Bandgap reference core
.subckt Bandgap out
.iodir out=output
.name out V_REF
XOA x y g opamp
.alias XOA OA
R1 out x
.name R1 R_1
R2 out y
.name R2 R_2
R3 y z
.name R3 R_3
Q1 0 0 x pnp
.name Q1 Q_1
Q2 0 0 z pnp
.name Q2 Q_2
RO g out
.name RO R_O
.ends
