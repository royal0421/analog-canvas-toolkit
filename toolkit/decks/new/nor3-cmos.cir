* hand-written deck, not exported from any drawing
.title Three-input CMOS NOR
.global VDD
.subckt NOR3 a b c y
.iodir a=input b=input c=input y=output
.name a A
.name b B
.name c C
.name y Out
MP1 p1 a VDD VDD pmos
.name MP1 M_P1
MP2 p2 b p1 VDD pmos
.name MP2 M_P2
MP3 y c p2 VDD pmos
.name MP3 M_P3
MN1 y a 0 0 nmos
.name MN1 M_N1
MN2 y b 0 0 nmos
.name MN2 M_N2
MN3 y c 0 0 nmos
.name MN3 M_N3
.ends
